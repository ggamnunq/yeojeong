project_id                 = "yeojeong-xxxxxx"
internal_job_oidc_audience = "https://yeojeong-api-000000000000.asia-northeast3.run.app"
billing_account            = "XXXXXX-XXXXXX-XXXXXX"
supabase_organization_id   = "supabase-org-slug"
github_repository_id       = "123456789"
github_repository_owner_id = "12345678"
cloudflare_account_id      = "0123456789abcdef0123456789abcdef"
# 카카오디벨로퍼스 앱 「여정」 > 앱 > 플랫폼 키 > REST API 키 / 클라이언트 시크릿(카카오 로그인). 커밋하지 않는다.
kakao_client_id     = "0123456789abcdef0123456789abcdef"
kakao_client_secret = "..."
# support@jinyeojeong.com 메일을 전달받을 운영자 주소. 커밋하지 않는다. 처음 적용하면 이 주소로 Cloudflare 확인 메일이 온다.
support_forward_to = "<운영자 메일 주소>"
# 감사 로그 버킷 보존 잠금(되돌릴 수 없음). 첫 적용 뒤 로그 유입을 확인하고 true로 바꾼다.
# audit_log_bucket_locked = true
# 사용자가 gcloud로 시크릿(yeojeong-kakao-admin-key, yeojeong-exim-api-key)을 만든 뒤에만 켠다. 값은 Terraform에 넣지 않는다.
enable_kakao_unlink = false
kakao_app_id        = ""
enable_exim_fx      = false
# 관리자 페이지(/admin). 시크릿 yeojeong-admin-username·yeojeong-admin-password-hash·yeojeong-admin-totp-secret을 gcloud로 만든 뒤에만 켠다(apps/api/src/admin/README.md).
enable_admin = false
# 카드 승인내역 불러오기(S8). CODEF 시크릿(yeojeong-codef-client-id·-client-secret·-public-key)을 gcloud로 만든 뒤에만 enable_codef를 켠다.
# 전체 공개(on)는 법률 자문(L-25) 뒤에만. 그 전에는 allowlist + 운영자 본인 사용자 ID로만 실테스트한다(ID는 커밋하지 않는다).
enable_codef                 = false
codef_env                    = "sandbox"
feature_card_import          = "off"
card_import_allowed_user_ids = []
# 현대·하나 카드번호 로그인. 약관 0.2(카드번호 처리) 게시 전에는 false
card_number_login            = false
codef_daily_call_budget      = 100
# 거래 내역 파일 가져오기(W10, 위챗페이). 처리방침에 수집 항목·방법을 반영한 뒤 on
feature_file_import = "off"

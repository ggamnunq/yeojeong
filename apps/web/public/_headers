# Cloudflare(Pages / Workers static assets)가 응답에 붙이는 보안 헤더. 빌드하면 dist/_headers로 복사된다.
# API를 다른 origin에 두면 connect-src에 그 origin을 추가해야 한다. docs/security.md 참고.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# 운영자 관리자 화면(/admin, SPA라 index.html이 응답한다): 색인 금지 + 캐시 금지. robots.txt에는 적지 않는다(경로를 광고하지 않게)
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# 초대 링크 진입(/join, W8 보안 리뷰 L1): 코드는 fragment(#code=)라 원래 Referer에 실리지 않지만, 예전 ?code= 링크도
# 받으므로 이 문서에서 나가는 요청에는 Referer를 보내지 않는다. 같은 헤더가 /*와 겹치면 쉼표로 이어지고(/* 다음),
# 브라우저는 목록의 마지막 정책(no-referrer)을 쓴다. 앱은 시작 즉시 주소에서 코드를 지운다(pendingInvite.captureInviteLink)
/join
  Referrer-Policy: no-referrer

# 배포된 빌드 ID(오래 열어 둔 탭이 새 번들이 나왔는지 확인한다, src/app/buildInfo.ts). 캐시하면 옛 값을 보게 되므로 no-store
/version.json
  Cache-Control: no-store

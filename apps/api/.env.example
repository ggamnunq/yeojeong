DATABASE_URL="postgresql://yeojeong:yeojeong@localhost:5432/yeojeong?schema=public"
# Prisma CLI(마이그레이션 등) 전용 연결. 비우면 DATABASE_URL을 쓴다. 로컬은 비워 둔다.
# 운영은 Supabase 세션 풀러(5432) 주소로, CI가 Secret Manager(yeojeong-direct-url)에서 넣어 준다.
# 자세한 내용은 prisma/README.md
DIRECT_URL=
PORT=3000
# 화면 주소(origin만). 로그인 후 리다이렉트 대상이고, 상태 변경 요청(POST 등)은 이 Origin에서 온 것만 받는다(CSRF).
# 로컬은 Vite 개발 서버, 운영은 https://jinyeojeong.com. 없으면 서버가 뜨지 않는다.
WEB_BASE_URL=http://localhost:5173

# ── 인증 (아래 값이 하나라도 없거나 형식이 틀리면 서버가 뜨지 않는다) ──
# 카카오디벨로퍼스 앱 「여정」 > 앱 > 플랫폼 키 > REST API 키, 같은 화면의 클라이언트 시크릿(카카오 로그인). 운영은 Secret Manager.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 Redirect URI와 같아야 한다. 로컬은 Vite가 /api를 API 서버로 넘긴다. 운영만 https 필수.
KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/kakao/callback
# 카카오 "연결 끊기 알림" 콜백(/api/auth/kakao/unlink) 인증용 Admin 키(카카오디벨로퍼스 > 앱 > 플랫폼 키 > Admin 키). 선택.
# 비우면 이 콜백은 404(기능 꺼짐). 운영은 Secret Manager(yeojeong-kakao-admin-key). Admin 키는 모든 권한을 가진 키라 로그·화면에 남기지 않는다.
KAKAO_ADMIN_KEY=
# 카카오 앱 ID(숫자, 비밀 아님). 있으면 콜백의 app_id도 확인한다. 선택.
KAKAO_APP_ID=
# 쿠키 서명용(32자 이상). 바꾸면 진행 중인 로그인·가입만 다시 하면 된다. 예: openssl rand -base64 48
SESSION_SECRET=
# 금융기관 토큰 등 *_enc 컬럼 암호화 키(AES-256-GCM). 32바이트를 base64로: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# 동의 기록·탈퇴 기록을 사용자와 묶는 HMAC 키(32자 이상). 한 번 정하면 바꾸지 않는다(바꾸면 과거 기록과 연결이 끊긴다)
USER_REF_HMAC_KEY=
# 접근 기록·동의 기록 IP와 공동 결제 원본 거래(sourceTxHash) HMAC 키(32자 이상). 운영(NODE_ENV=production)은 필수(없으면 서버가 뜨지 않는다).
# 로컬에서 비우면 IP 해시·sourceTxHash를 남기지 않는다.
AUDIT_HMAC_KEY=
# 결제 제공자: 현재 통합 예정인 데모 어댑터 설정.
PAYMENT_PROVIDER=demo
# 계좌·카드 자동 불러오기(토스 연결) 진입점을 화면에 보일지(GET /api/auth/session features.accountLink).
# 기본 false(숨김). 연결 API는 플래그와 무관하게 동작한다.
FEATURE_ACCOUNT_LINK=false
# 카드 승인내역 불러오기(S8, CODEF 일회성 조회): off(기본) | allowlist | on. allowlist면 CARD_IMPORT_ALLOWED_USER_IDS의 사용자만.
# CODEF 키 세 개가 모두 있어야 켜진다(없으면 off). src/card-import/README.md
FEATURE_CARD_IMPORT=off
# 쉼표로 구분한 사용자 UUID(allowlist일 때만). 커밋하지 않는다
CARD_IMPORT_ALLOWED_USER_IDS=
# sandbox(고정 샘플, 기본) | development(데모 키) | production
CODEF_ENV=sandbox
# direct(기본, CODEF 계정을 만들지 않음) | account(계정 등록 → 조회 → 삭제, direct가 막힐 때만)
CODEF_LOGIN_MODE=direct
# CODEF 콘솔의 클라이언트 ID·시크릿·RSA 공개키. 운영은 Secret Manager(yeojeong-codef-*). 로컬은 비워 둔다
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
# 서비스 전체 CODEF API 일일 호출 예산(KST, 기본 100). 남은 예산이 4보다 적으면 새 조회를 시작하지 않는다(503 CARD_IMPORT_DAILY_LIMIT)
CODEF_DAILY_CALL_BUDGET=100
# 환율 수집: demo는 샘플 값, koreaexim은 한국수출입은행 OpenAPI, erapi는 ExchangeRate-API(키 없음),
# koreaexim+erapi는 한국수출입은행 + 고시 안 하는 통화(TWD·VND·PHP 등)만 ExchangeRate-API.
# 비우면 EXIM_API_KEY가 있을 때 koreaexim+erapi, 없으면 demo. koreaexim·koreaexim+erapi인데 키가 없으면 서버가 뜨지 않는다.
FX_RATE_SOURCE=demo
# 한국수출입은행 OpenAPI 인증키(현재환율). 운영은 Secret Manager(yeojeong-exim-api-key). 로컬은 비워 둔다(데모 값으로 충분)
EXIM_API_KEY=
# 탈퇴·삭제 요청 메일 초안의 받는 주소(FR-108). 운영은 Cloudflare Email Routing으로 받는다(infra var.support_email)
SUPPORT_EMAIL=support@jinyeojeong.com
# 로그 레벨(trace, debug, info, warn, error, silent). 비우면 운영 info, 로컬 debug
LOG_LEVEL=
# 화면이 다른 도메인에서 API를 호출할 때만 설정 (예: https://yeojeong.example.com)
# 운영은 화면과 API가 같은 origin(jinyeojeong.com)이라 비워 둔다.
# 쉼표로 여러 개를 적을 수 있고, 경로·와일드카드 없이 정확한 origin만 허용
WEB_ORIGIN=
# X-Forwarded-For에서 믿을 프록시 단계 수. 비우면 Cloud Run에서는 1, 로컬에서는 0
TRUST_PROXY_HOPS=
# 운영 전용(Secret Manager). Cloudflare Worker만 아는 값으로, 없는 요청은 403. 로컬에서는 비워 둔다.
ORIGIN_SECRET=
# Cloud Scheduler OIDC ID token의 aud. 운영은 Cloud Run 서비스 URL(경로 없음).
INTERNAL_JOB_OIDC_AUDIENCE=
# Cloud Scheduler가 OIDC 토큰을 발급받는 서비스 계정 이메일.
INTERNAL_JOB_OIDC_SERVICE_ACCOUNT=
# 로컬·테스트 전용 대체 인증(32자 이상). NODE_ENV=production에서는 무시한다.
INTERNAL_JOB_SECRET=
